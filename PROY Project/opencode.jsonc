{
  "$schema": "https://opencode.ai/config.json",
  "mcpServers": {
    "ctrader": {
      "type": "http",
      "url": "http://127.0.0.1:9876/mcp/"
    }
  },
  "permission": {
    "edit": {
      "*.md": "allow",
      "*": "deny"
    },
    "bash": "deny",
    "external_directory": {
      "~/OneDrive*/PROY/**": "allow",
      "*": "deny"
    }
  }
}
